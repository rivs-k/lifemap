# Modèle de configuration — copier vers .env.local et remplir avec les clés Supabase.
# Ces deux valeurs se trouvent dans Supabase : Project Settings > API.
# La clé anon est publique (protégée côté serveur par Row Level Security) : safe à exposer au navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé Gemini (assistant IA de décomposition d'objectif, tier gratuit). Sans le
# préfixe NEXT_PUBLIC_ : elle n'est utilisée que côté serveur, dans app/api/.
# À récupérer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=...
